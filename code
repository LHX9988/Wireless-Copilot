# -------------------------- 全局参数配置--------------------------
class Config:
    # 场景参数
    AREA_SIZE = 500  # 500x500 m
    UAV_NUM = 4      # 4架旋翼UAV
    USER_NUM = {
        'SAR': 20,    # SAR团队用户（URLLC）
        'Medical': 15, # 医疗团队用户（eMBB）
        'Civilian': 30 # 平民用户（突发通信）
    }
    SECTOR_A = [(0, 0), (250, 500)]  # Sector A：左半区域（URLLC优先）
    SECTOR_B = [(250, 0), (500, 500)]# Sector B：右半区域（吞吐量优先）
    
    # 通信参数
    CARRIER_FREQ = 28e9  # 28 GHz
    BANDWIDTH = 400e6    # 400 MHz
    NOISE_POWER = -174 + 10*np.log10(BANDWIDTH) + 10  # 噪声功率 (dBm)
    LOS_PATH_LOSS_EXP = 2.1  # LoS路径损耗指数
    NLOS_PATH_LOSS_EXP = 3.5 # NLoS路径损耗指数
    REFERENCE_DISTANCE = 10  # 参考距离10m
    REFERENCE_LOSS = 20*np.log10(4*np.pi*REFERENCE_DISTANCE*CARRIER_FREQ/3e8)  # 参考路径损耗
    
    # UAV参数
    UAV_MAX_ALT = 100  # 最大高度100m
    UAV_MIN_ALT = 30   # 最小高度30m
    UAV_SPEED = 5      # 最大速度5 m/s
    BATTERY_CAPACITY = 30*60  # 电池容量（30分钟，秒为单位）
    POWER_BLADE = 79.8  # 桨叶轮廓功率 (W)
    POWER_INDUCED = 88.6 # 诱导功率 (W)
    ROTOR_SPEED = 120   # 旋翼尖速 (m/s)
    
    # QoS约束
    URLLC_LATENCY_THRESHOLD = 0.1  # URLLC延迟阈值0.1ms
    EMBB_THROUGHPUT_THRESHOLD = 1e9 # eMBB吞吐量阈值1Gbps
    CIVILIAN_PACKET_RATE = 1e6     # 平民数据包速率1Mbps
    
    # 仿真参数
    EPISODES = 200      # 训练轮数
    SLOTS_PER_EPISODE = 100  # 每轮时隙数
    USER_DENSITY_RANGE = [50, 150]  # 用户密度范围
    HITL_FEEDBACK_PROB = 0.3  # HITL反馈概率

# -------------------------- 网络环境建模 --------------------------
class LAWNetsEnv:
    def __init__(self, user_density):
        self.config = Config()
        self.user_density = user_density
        
        # 初始化UAV位置（均匀分布在区域内）
        self.uav_positions = np.random.uniform(0, self.config.AREA_SIZE, (self.config.UAV_NUM, 3))  # (x, y, z)
        self.uav_positions[:, 2] = np.random.uniform(self.config.UAV_MIN_ALT, self.config.UAV_MAX_ALT, self.config.UAV_NUM)
        self.uav_batteries = np.full(self.config.UAV_NUM, self.config.BATTERY_CAPACITY)  # 初始电池容量
        
        # 初始化用户（三类用户，按区域分配）
        self.users = self._init_users()
        
        # 信道状态记录
        self.channel_gains = np.zeros((self.config.UAV_NUM, len(self.users)))
        self.los_status = np.zeros((self.config.UAV_NUM, len(self.users)), dtype=bool)
        
    def _init_users(self):
        """初始化三类用户，按区域分配"""
        users = []
        # SAR用户（Sector A，URLLC）
        sar_num = int(self.user_density * 0.3)
        for _ in range(sar_num):
            x = np.random.uniform(self.config.SECTOR_A[0][0], self.config.SECTOR_A[1][0])
            y = np.random.uniform(self.config.SECTOR_A[0][1], self.config.SECTOR_A[1][1])
            users.append({
                'type': 'SAR',
                'pos': np.array([x, y]),
                'velocity': np.random.uniform(-1, 1, 2),  # 初始速度
                'qos': {'latency': self.config.URLLC_LATENCY_THRESHOLD, 'throughput': 0}
            })
        
        # 医疗用户（Sector B，eMBB）
        medical_num = int(self.user_density * 0.2)
        for _ in range(medical_num):
            x = np.random.uniform(self.config.SECTOR_B[0][0], self.config.SECTOR_B[1][0])
            y = np.random.uniform(self.config.SECTOR_B[0][1], self.config.SECTOR_B[1][1])
            users.append({
                'type': 'Medical',
                'pos': np.array([x, y]),
                'velocity': np.random.uniform(-0.8, 0.8, 2),
                'qos': {'latency': 1.0, 'throughput': self.config.EMBB_THROUGHPUT_THRESHOLD}
            })
        
        # 平民用户（全区域，突发通信）
        civil_num = int(self.user_density * 0.5)
        for _ in range(civil_num):
            x = np.random.uniform(0, self.config.AREA_SIZE)
            y = np.random.uniform(0, self.config.AREA_SIZE)
            users.append({
                'type': 'Civilian',
                'pos': np.array([x, y]),
                'velocity': np.random.uniform(-0.5, 0.5, 2),
                'qos': {'latency': 5.0, 'throughput': self.config.CIVILIAN_PACKET_RATE}
            })
        return users
    
    def _update_user_positions(self):
        """更新用户位置（Gauss-Markov移动模型）"""
        alpha = 0.8  # 平滑系数
        for user in self.users:
            user['pos'] += user['velocity']
            # 边界反弹
            user['pos'] = np.clip(user['pos'], 0, self.config.AREA_SIZE)
            # Gauss-Markov更新速度
            user['velocity'] = alpha * user['velocity'] + (1 - alpha) * np.random.uniform(-1, 1, 2)
    
    def _calculate_channel_gain(self):
        """计算信道增益（区分LoS/NLoS）"""
        for uav_idx in range(self.config.UAV_NUM):
            uav_pos = self.uav_positions[uav_idx]
            for user_idx, user in enumerate(self.users):
                # 计算距离
                dist_2d = np.linalg.norm(uav_pos[:2] - user['pos'])
                dist_3d = np.linalg.norm(uav_pos - np.append(user['pos'], 1.5))  # 用户高度1.5m
                
                # 判断LoS状态（简化：距离<150m且无遮挡视为LoS）
                self.los_status[uav_idx, user_idx] = dist_2d < 150
                
                # 路径损耗计算
                if self.los_status[uav_idx, user_idx]:
                    path_loss = self.config.REFERENCE_LOSS + 10 * self.config.LOS_PATH_LOSS_EXP * np.log10(dist_3d / self.config.REFERENCE_DISTANCE)
                else:
                    path_loss = self.config.REFERENCE_LOSS + 10 * self.config.NLOS_PATH_LOSS_EXP * np.log10(dist_3d / self.config.REFERENCE_DISTANCE)
                
                # 信道增益（dBm转线性）
                self.channel_gains[uav_idx, user_idx] = 10 ** ((43 - path_loss - self.config.NOISE_POWER) / 10)  # 发射功率43dBm（20W）
    
    def _calculate_uav_power_consumption(self, uav_idx, transmit_power):
        """计算UAV功耗（论文中的Blade Element Momentum模型）"""
        uav_pos = self.uav_positions[uav_idx]
        # 飞行功耗 = 桨叶轮廓功率 + 诱导功率（与高度相关）
        flight_power = self.config.POWER_BLADE + self.config.POWER_INDUCED * (uav_pos[2] / self.config.UAV_MAX_ALT)
        # 传输功耗（与发射功率成正比）
        transmit_power_watt = 10 ** (transmit_power / 10)  # dBm转W
        transmit_power = 0.1 * transmit_power_watt  # 传输效率10%
        total_power = flight_power + transmit_power
        return total_power
    
    def step(self, actions):
        """环境步进：执行动作，返回下一个状态和奖励"""
        # 动作格式：每个UAV的(位置调整量dx, dy, dz, 发射功率dBm, 信道分配)
        rewards = []
        qos_satisfied = []
        
        # 更新UAV位置和电池
        for uav_idx in range(self.config.UAV_NUM):
            dx, dy, dz, transmit_power, channel_assignment = actions[uav_idx]
            # 更新位置（限制在区域内和高度范围内）
            self.uav_positions[uav_idx, 0] = np.clip(self.uav_positions[uav_idx, 0] + dx, 0, self.config.AREA_SIZE)
            self.uav_positions[uav_idx, 1] = np.clip(self.uav_positions[uav_idx, 1] + dy, 0, self.config.AREA_SIZE)
            self.uav_positions[uav_idx, 2] = np.clip(self.uav_positions[uav_idx, 2] + dz, self.config.UAV_MIN_ALT, self.config.UAV_MAX_ALT)
            
            # 计算功耗并更新电池
            power_consumption = self._calculate_uav_power_consumption(uav_idx, transmit_power)
            self.uav_batteries[uav_idx] -= power_consumption  # 每个时隙1秒
        
        # 更新用户位置和信道状态
        self._update_user_positions()
        self._calculate_channel_gain()
        
        # 评估QoS满足情况
        for user_idx, user in enumerate(self.users):
            # 找到服务该用户的UAV（信道分配）
            serving_uav = None
            for uav_idx in range(self.config.UAV_NUM):
                if user_idx in actions[uav_idx][4]:
                    serving_uav = uav_idx
                    break
            
            if serving_uav is None:
                qos_satisfied.append(False)
                continue
            
            # 计算吞吐量和延迟
            channel_gain = self.channel_gains[serving_uav, user_idx]
            throughput = channel_gain * self.config.BANDWIDTH  # 香农公式简化
            # 延迟 = 数据包大小 / 吞吐量（假设数据包大小1000字节）
            latency = (1000 * 8) / throughput if throughput > 0 else float('inf')
            
            # 检查QoS约束
            if user['type'] == 'SAR':
                satisfied = latency <= user['qos']['latency']
            elif user['type'] == 'Medical':
                satisfied = throughput >= user['qos']['throughput']
            else:  # Civilian
                satisfied = throughput >= user['qos']['throughput'] and latency <= user['qos']['latency']
            qos_satisfied.append(satisfied)
        
        # 计算奖励（基于QoS满足率和电池寿命）
        qos_satisfaction_rate = np.mean(qos_satisfied)
        avg_battery_life = np.mean(self.uav_batteries) / 60  # 转换为分钟
        battery_penalty = max(0, 30 - avg_battery_life) / 30  # 低于30分钟惩罚
        reward = qos_satisfaction_rate - battery_penalty
        
        # 检查终止条件（电池耗尽）
        done = np.any(self.uav_batteries <= 0)
        
        # 状态：UAV位置、电池、用户位置、信道增益
        state = {
            'uav_positions': self.uav_positions.copy(),
            'uav_batteries': self.uav_batteries.copy(),
            'user_positions': np.array([user['pos'] for user in self.users]),
            'channel_gains': self.channel_gains.copy(),
            'qos_satisfied': np.array(qos_satisfied)
        }
        
        return state, reward, done, {'ISR': qos_satisfaction_rate, 'avg_battery': avg_battery_life}

# -------------------------- 对比算法实现 --------------------------
class PPOAgent:
    """PPO算法（单智能体，每个UAV独立）"""
    def __init__(self, state_dim, action_dim):
        self.state_dim = state_dim
        self.action_dim = action_dim
        self.gamma = 0.99
        self.lamda = 0.95
        self.clip_epsilon = 0.2
        self.actor_lr = 3e-4
        self.critic_lr = 3e-4
        
        # 策略网络和价值网络
        self.actor = nn.Sequential(
            nn.Linear(state_dim, 64),
            nn.Tanh(),
            nn.Linear(64, 64),
            nn.Tanh(),
            nn.Linear(64, action_dim * 2)  # 均值和方差
        )
        self.critic = nn.Sequential(
            nn.Linear(state_dim, 64),
            nn.Tanh(),
            nn.Linear(64, 64),
            nn.Tanh(),
            nn.Linear(64, 1)
        )
        
        self.actor_optim = optim.Adam(self.actor.parameters(), lr=self.actor_lr)
        self.critic_optim = optim.Adam(self.critic.parameters(), lr=self.critic_lr)
    
    def get_action(self, state):
        """获取动作（含探索）"""
        state_tensor = torch.FloatTensor(state).unsqueeze(0)
        output = self.actor(state_tensor)
        mean = output[:, :self.action_dim]
        log_std = output[:, self.action_dim:]
        std = torch.exp(log_std)
        
        dist = torch.distributions.Normal(mean, std)
        action = dist.sample()
        log_prob = dist.log_prob(action).sum(dim=-1)
        
        # 动作剪辑
        action = torch.clamp(action, -1, 1)
        return action.detach().numpy()[0], log_prob.detach().numpy()[0]

class MADDPGAgent:
    """MADDPG算法（多智能体协作）"""
    def __init__(self, num_agents, state_dim, action_dim):
        self.num_agents = num_agents
        self.state_dim = state_dim
        self.action_dim = action_dim
        
        # 每个智能体的策略网络和价值网络
        self.actors = [self._build_actor() for _ in range(num_agents)]
        self.critics = [self._build_critic() for _ in range(num_agents)]
        
        self.actor_optims = [optim.Adam(actor.parameters(), lr=3e-4) for actor in self.actors]
        self.critic_optims = [optim.Adam(critic.parameters(), lr=3e-4) for critic in self.critics]
    
    def _build_actor(self):
        return nn.Sequential(
            nn.Linear(self.state_dim, 64),
            nn.ReLU(),
            nn.Linear(64, 64),
            nn.ReLU(),
            nn.Linear(64, self.action_dim),
            nn.Tanh()
        )
    
    def _build_critic(self):
        #  Critic输入：所有智能体的状态和动作
        return nn.Sequential(
            nn.Linear(self.num_agents * (self.state_dim + self.action_dim), 128),
            nn.ReLU(),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, 1)
        )
    
    def get_actions(self, states):
        """获取所有智能体的动作"""
        actions = []
        for i in range(self.num_agents):
            state_tensor = torch.FloatTensor(states[i]).unsqueeze(0)
            action = self.actors[i](state_tensor)
            actions.append(action.detach().numpy()[0])
        return actions

class LLMBaseAgent:
    """传统LLMAgent（无HITL反馈）"""
    def __init__(self, env):
        self.env = env
        self.config = Config()
    
    def parse_intent(self):
        """解析意图为QoS权重"""
        return {
            'SAR_latency_weight': 0.5,    # 优先URLLC
            'Medical_throughput_weight': 0.3,  # 次优先eMBB吞吐量
            'battery_weight': 0.2         # 电池寿命权重
        }
    
    def get_action(self, state):
        """基于LLM生成动作（规则化模拟）"""
        weights = self.parse_intent()
        actions = []
        
        for uav_idx in range(self.config.UAV_NUM):
            # 基于QoS权重调整UAV位置
            sar_users = [i for i, user in enumerate(self.env.users) if user['type'] == 'SAR']
            medical_users = [i for i, user in enumerate(self.env.users) if user['type'] == 'Medical']
            
            # 计算SAR用户中心
            if sar_users:
                sar_center = np.mean([self.env.users[i]['pos'] for i in sar_users], axis=0)
                dx = weights['SAR_latency_weight'] * (sar_center[0] - state['uav_positions'][uav_idx, 0]) / 100
                dy = weights['SAR_latency_weight'] * (sar_center[1] - state['uav_positions'][uav_idx, 1]) / 100
            else:
                dx, dy = 0, 0
            
            # 计算医疗用户中心
            if medical_users:
                medical_center = np.mean([self.env.users[i]['pos'] for i in medical_users], axis=0)
                dx += weights['Medical_throughput_weight'] * (medical_center[0] - state['uav_positions'][uav_idx, 0]) / 100
                dy += weights['Medical_throughput_weight'] * (medical_center[1] - state['uav_positions'][uav_idx, 1]) / 100
            
            # 电池保护：电池低则升高高度减少功耗
            dz = -0.1 if state['uav_batteries'][uav_idx] / self.config.BATTERY_CAPACITY < 0.5 else 0.0
            
            # 发射功率：根据信道增益调整
            avg_gain = np.mean(state['channel_gains'][uav_idx])
            transmit_power = 43 if avg_gain < 0.1 else 33  # 信道差则增大功率
            
            # 信道分配：优先分配给高优先级用户
            all_users = np.argsort([-weights['SAR_latency_weight'] if self.env.users[i]['type'] == 'SAR' 
                                  else -weights['Medical_throughput_weight'] if self.env.users[i]['type'] == 'Medical' 
                                  else -0.1 for i in range(len(self.env.users))])
            channel_assignment = all_users[:int(len(self.env.users)/self.config.UAV_NUM)]  # 均分用户
            
            actions.append((dx, dy, dz, transmit_power, channel_assignment))
        
        return actions

class WirelessCopilotAgent(LLMBaseAgent):
    """Wireless Copilot（带HITL反馈）"""
    def __init__(self, env):
        super().__init__(env)
    
    def hitl_feedback(self, current_weights, qos_metrics):
        """模拟HITL反馈：校准意图权重"""
        # 如果SAR延迟违反率高，增加URLLC权重
        sar_latency_violation = qos_metrics.get('SAR_latency_violation', 0)
        if sar_latency_violation > 0.1:
            current_weights['SAR_latency_weight'] = min(0.7, current_weights['SAR_latency_weight'] + 0.1)
        
        # 如果医疗吞吐量不足，增加eMBB权重
        medical_throughput_violation = qos_metrics.get('Medical_throughput_violation', 0)
        if medical_throughput_violation > 0.1:
            current_weights['Medical_throughput_weight'] = min(0.4, current_weights['Medical_throughput_weight'] + 0.05)
        
        # 归一化权重
        total = sum(current_weights.values())
        for k in current_weights:
            current_weights[k] /= total
        return current_weights
    
    def get_action(self, state, qos_metrics=None):
        """结合HITL反馈生成动作"""
        weights = self.parse_intent()
        # 应用HITL反馈（每3个时隙一次）
        if qos_metrics and np.random.random() < self.config.HITL_FEEDBACK_PROB:
            weights = self.hitl_feedback(weights, qos_metrics)
        
        actions = []
        for uav_idx in range(self.config.UAV_NUM):
            # 基于校准后的权重调整位置
            sar_users = [i for i, user in enumerate(self.env.users) if user['type'] == 'SAR']
            medical_users = [i for i, user in enumerate(self.env.users) if user['type'] == 'Medical']
            
            dx, dy = 0, 0
            if sar_users:
                sar_center = np.mean([self.env.users[i]['pos'] for i in sar_users], axis=0)
                dx = weights['SAR_latency_weight'] * (sar_center[0] - state['uav_positions'][uav_idx, 0]) / 80  # 权重更高，调整更激进
                dy = weights['SAR_latency_weight'] * (sar_center[1] - state['uav_positions'][uav_idx, 1]) / 80
            
            if medical_users:
                medical_center = np.mean([self.env.users[i]['pos'] for i in medical_users], axis=0)
                dx += weights['Medical_throughput_weight'] * (medical_center[0] - state['uav_positions'][uav_idx, 0]) / 80
                dy += weights['Medical_throughput_weight'] * (medical_center[1] - state['uav_positions'][uav_idx, 1]) / 80
            
            # 电池保护（更智能：结合用户分布）
            battery_ratio = state['uav_batteries'][uav_idx] / self.config.BATTERY_CAPACITY
            user_density_around = len([i for i in range(len(self.env.users)) if np.linalg.norm(state['uav_positions'][uav_idx, :2] - self.env.users[i]['pos']) < 100])
            dz = -0.2 if (battery_ratio < 0.5 and user_density_around < 10) else 0.0
            
            # 发射功率（基于HITL反馈调整）
            avg_gain = np.mean(state['channel_gains'][uav_idx])
            if sar_latency_violation := qos_metrics.get('SAR_latency_violation', 0) > 0.05:
                transmit_power = 45  # 优先保证SAR延迟
            else:
                transmit_power = 43 if avg_gain < 0.1 else 33
            
            # 信道分配（优先满足QoS约束）
            user_priorities = []
            for i, user in enumerate(self.env.users):
                if user['type'] == 'SAR':
                    priority = weights['SAR_latency_weight'] * (1 - state['qos_satisfied'][i])
                elif user['type'] == 'Medical':
                    priority = weights['Medical_throughput_weight'] * (1 - state['qos_satisfied'][i])
                else:
                    priority = 0.1 * (1 - state['qos_satisfied'][i])
                user_priorities.append(priority)
            channel_assignment = np.argsort(-np.array(user_priorities))[:int(len(self.env.users)/self.config.UAV_NUM)]
            
            actions.append((dx, dy, dz, transmit_power, channel_assignment))
        
        return actions

# -------------------------- 仿真主函数 --------------------------
def run_simulation():
    config = Config()
    user_densities = np.linspace(config.USER_DENSITY_RANGE[0], config.USER_DENSITY_RANGE[1], 5)
    results = defaultdict(lambda: {'ISR': [], 'EE': [], 'latency': [], 'battery': []})
    
    # 遍历不同用户密度
    for density in user_densities:
        print(f"正在仿真用户密度：{density:.0f}")
        
        # 初始化环境和智能体
        env = LAWNetsEnv(density)
        ppo_agents = [PPOAgent(state_dim=10, action_dim=5) for _ in range(config.UAV_NUM)]  # 简化状态维度
        maddpg_agent = MADDPGAgent(num_agents=config.UAV_NUM, state_dim=10, action_dim=5)
        llm_agent = LLMBaseAgent(env)
        copilot_agent = WirelessCopilotAgent(env)
        
        # 每种算法运行EPISODES轮
        for algo in ['PPO', 'MADDPG', 'LLM', 'Copilot']:
            algo_ISR = []
            algo_EE = []
            algo_latency = []
            algo_battery = []
            
            for episode in range(config.EPISODES):
                env = LAWNetsEnv(density)  # 重置环境
                state = {
                    'uav_positions': env.uav_positions.copy(),
                    'uav_batteries': env.uav_batteries.copy(),
                    'user_positions': np.array([user['pos'] for user in env.users]),
                    'channel_gains': env.channel_gains.copy(),
                    'qos_satisfied': np.zeros(len(env.users), dtype=bool)
                }
                qos_metrics = {'SAR_latency_violation': 0, 'Medical_throughput_violation': 0}
                total_ISR = 0
                total_EE = 0
                total_latency = 0
                total_battery = 0
                
                for slot in range(config.SLOTS_PER_EPISODE):
                    # 获取动作
                    if algo == 'PPO':
                        actions = []
                        for i in range(config.UAV_NUM):
                            action, _ = ppo_agents[i].get_action(state['uav_positions'][i].flatten())
                            # 转换为动作格式：(dx, dy, dz, transmit_power, channel_assignment)
                            dx, dy, dz = action[:3] * 2  # 位置调整量缩放
                            transmit_power = 33 + (action[3] + 1) * 10  # 33-53dBm
                            channel_assignment = np.argsort(-state['channel_gains'][i])[:int(len(env.users)/config.UAV_NUM)]
                            actions.append((dx, dy, dz, transmit_power, channel_assignment))
                    
                    elif algo == 'MADDPG':
                        agent_states = [state['uav_positions'][i].flatten() for i in range(config.UAV_NUM)]
                        raw_actions = maddpg_agent.get_actions(agent_states)
                        actions = []
                        for action in raw_actions:
                            dx, dy, dz = action[:3] * 2
                            transmit_power = 33 + (action[3] + 1) * 10
                            channel_assignment = np.argsort(-state['channel_gains'][0])[:int(len(env.users)/config.UAV_NUM)]
                            actions.append((dx, dy, dz, transmit_power, channel_assignment))
                    
                    elif algo == 'LLM':
                        actions = llm_agent.get_action(state)
                    
                    elif algo == 'Copilot':
                        actions = copilot_agent.get_action(state, qos_metrics)
                    
                    # 执行动作
                    next_state, reward, done, info = env.step(actions)
                    
                    # 计算性能指标
                    total_ISR += info['ISR']
                    total_battery += info['avg_battery']
                    
                    # 计算EE和延迟
                    total_data = 0
                    total_energy = 0
                    total_lat = 0
                    sar_latency_violation = 0
                    medical_throughput_violation = 0
                    
                    for uav_idx in range(config.UAV_NUM):
                        # 计算传输数据量
                        transmit_power = actions[uav_idx][3]
                        transmit_power_watt = 10 ** (transmit_power / 10)
                        channel_gain = np.mean(next_state['channel_gains'][uav_idx])
                        throughput = channel_gain * config.BANDWIDTH
                        data = throughput * 1  # 1秒时隙
                        total_data += data
                        
                        # 计算能耗
                        energy = env._calculate_uav_power_consumption(uav_idx, transmit_power) * 1
                        total_energy += energy
                        
                        # 计算延迟
                        latency = (1000 * 8) / throughput if throughput > 0 else float('inf')
                        total_lat += latency
                    
                    # 计算QoS违反率
                    sar_users = [i for i, user in enumerate(env.users) if user['type'] == 'SAR']
                    if sar_users:
                        sar_latency_violation = np.mean([1 - next_state['qos_satisfied'][i] for i in sar_users])
                    medical_users = [i for i, user in enumerate(env.users) if user['type'] == 'Medical']
                    if medical_users:
                        medical_throughput_violation = np.mean([1 - next_state['qos_satisfied'][i] for i in medical_users])
                    qos_metrics = {'SAR_latency_violation': sar_latency_violation, 'Medical_throughput_violation': medical_throughput_violation}
                    
                    # 更新累计指标
                    if total_energy > 0:
                        total_EE += total_data / total_energy / 1e6  # 转换为Mbits/Joule
                    total_latency += total_lat / len(env.users)
                    
                    state = next_state
                    if done:
                        break
                
                # 计算每轮平均指标
                avg_ISR = total_ISR / config.SLOTS_PER_EPISODE
                avg_EE = total_EE / config.SLOTS_PER_EPISODE
                avg_latency = total_latency / config.SLOTS_PER_EPISODE
                avg_battery = total_battery / config.SLOTS_PER_EPISODE
                
                algo_ISR.append(avg_ISR)
                algo_EE.append(avg_EE)
                algo_latency.append(avg_latency)
                algo_battery.append(avg_battery)
                
                # 打印进度
                if (episode + 1) % 50 == 0:
                    print(f"  {algo} - 轮次 {episode+1}/{config.EPISODES}: ISR={avg_ISR:.3f}, EE={avg_EE:.3f}, 延迟={avg_latency:.3f}ms")
            
            # 保存结果（取最后50轮平均值）
            results[algo]['ISR'].append(np.mean(algo_ISR[-50:]))
            results[algo]['EE'].append(np.mean(algo_EE[-50:]))
            results[algo]['latency'].append(np.mean(algo_latency[-50:]))
            results[algo]['battery'].append(np.mean(algo_battery[-50:]))
    

